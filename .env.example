# ChatbotX — variáveis de ambiente (produção / EasyPanel)
#
# Copie para `.env` e substitua TODOS os valores marcados com <...>.
# Gere segredos novos — não reutilize os exemplos de nenhum tutorial.
#
#   openssl rand -base64 32   # BETTER_AUTH_SECRET
#   openssl rand -hex 32      # ENCRYPTION_KEY, REALTIME_BROADCAST_SECRET
#   openssl rand -hex 24      # senhas / tokens

# ---------------------------------------------------------------------
# Domínios (sem https://, sem barra final)
# ---------------------------------------------------------------------
APP_DOMAIN=app.seudominio.com
REALTIME_DOMAIN=rt.seudominio.com
S3_DOMAIN=s3.seudominio.com

# ---------------------------------------------------------------------
# Banco de dados (PostgreSQL / TimescaleDB)
# ---------------------------------------------------------------------
POSTGRES_DB=chatbotx
POSTGRES_USER=chatbotx
POSTGRES_PASSWORD=<gere-uma-senha-forte>
# "all" apenas para depuração; deixe "none" em produção.
POSTGRES_LOG_STATEMENT=none

# ---------------------------------------------------------------------
# Segredos da aplicação
# ---------------------------------------------------------------------
BETTER_AUTH_SECRET=<openssl rand -base64 32>
ENCRYPTION_KEY=<openssl rand -hex 32>
REALTIME_API_KEY=<openssl rand -hex 24>
REALTIME_BROADCAST_SECRET=<openssl rand -hex 32>
# Mínimo 32 caracteres.
JAVASCRIPT_EXECUTOR_TOKEN=<openssl rand -hex 24>

# ---------------------------------------------------------------------
# Armazenamento de objetos (RustFS, S3-compatível)
# ---------------------------------------------------------------------
RUSTFS_ACCESS_KEY=chatbotx
RUSTFS_SECRET_KEY=<openssl rand -hex 24>
S3_BUCKET=chatbotx
S3_REGION=us-west-2

# ---------------------------------------------------------------------
# Painel de plataforma (/manage)
# ---------------------------------------------------------------------
# E-mail da conta que administra a plataforma. É em /manage que se cadastram
# as credenciais de Meta, Google e TikTok — sem elas os canais WhatsApp,
# Instagram, Messenger, Threads e TikTok aparecem desativados na interface.
# Precisa bater exatamente com o e-mail de uma conta já registrada.
PLATFORM_ADMIN_EMAIL=voce@seudominio.com

# Verbosidade: error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------
# E-mail (SMTP) — obrigatório para convites e recuperação de senha.
# Use um provedor real: Resend, SendGrid, Amazon SES, Mailgun...
# ---------------------------------------------------------------------
# ATENÇÃO: os valores abaixo são MODELOS. Substitua pelos seus de verdade —
# colar isto como está faz todo envio de e-mail falhar.
# O domínio do SMTP_FROM precisa estar verificado no provedor (SPF/DKIM).
SMTP_FROM=no-reply@seudominio.com
SMTP_SERVER=smtp://USUARIO:SENHA@smtp.provedor.com:587

# Exemplo com Resend (3k e-mails/mês grátis):
#   SMTP_FROM=no-reply@seudominio.com.br
#   SMTP_SERVER=smtp://resend:re_SuaChaveReal@smtp.resend.com:587
#
# Exemplo com Gmail (porta 465, TLS implícito; use App Password, e %40 no @):
#   SMTP_SERVER=smtps://voce%40gmail.com:senha_de_app@smtp.gmail.com:465

# ---------------------------------------------------------------------
# Migrações e seed
# ---------------------------------------------------------------------
# Mantenha true: aplica migrações pendentes a cada deploy.
RUN_DB_MIGRATE=true
# true SOMENTE no primeiro boot. Volte para false em seguida.
RUN_DB_SEED=false

# ---------------------------------------------------------------------
# Limites de recursos (ajuste conforme a VPS)
# ---------------------------------------------------------------------
# Heap do Node (builder) em MB. VPS 8 GB compartilhada: 1536. VPS dedicada: 4096.
NODE_MAX_OLD_SPACE=1536
# Teto de RAM do builder (o proxy tira o serviço do ar se ele for morto por OOM).
BUILDER_MEMORY=2g

# O comando `worker all` sobe 14 processos Node dentro de UM container.
# O heap abaixo é por processo; o limite de memória é para a soma de todos.
# Apertar demais o limite faz o supervisor ser morto (status 137) e reiniciar
# em loop — sem fila nenhuma sendo processada.
# Em VPS pequena, prefira rodar só as filas necessárias a reduzir o teto:
#   command: ["worker", "chat", "integration", "webhook", "schedule"]
WORKER_MAX_OLD_SPACE=256
WORKER_MEMORY=2560m

REALTIME_MAX_OLD_SPACE=512
REALTIME_MEMORY=768m

# Execuções simultâneas de JS no sandbox.
MAX_CONCURRENCY=2
JS_EXECUTOR_CPUS=1
JS_EXECUTOR_MEMORY=512M
